    <string name="error_dialog_title">Åh nej - hvad nu? 🙁</string>
    <string name="error_dialog_tip_token_mismatch_retry">Prøv at tvinge appen til at lukke, og start den igen. Der kan have været en forkert forbindelse til Nextcloud-appen.</string>
    <string name="error_dialog_tip_clear_storage_might_help">Hvis problemet fortsætter, kan du prøve at rydde lageret for begge apps: Nextcloud og Nextcloud Tabeller.</string>
    <string name="error_dialog_tip_database_upgrade_failed">Opgraderingen af databasen mislykkedes. Rapportér problemet, og ryd lageret for at bruge appen normalt.</string>
    <string name="error_dialog_tip_clear_storage">Du kan rydde lageret ved at åbne appoplysningerne og vælge Lager → Ryd lager.</string>
    <string name="error_dialog_tip_offline_no_internet">Det ser ud til, at du forsøgte at starte en synkronisering uden internetforbindelse.</string>
    <string name="error_dialog_tip_offline_connection_refused">Forbindelsen blev afvist. Kontrollér, om din server kan nås via en webbrowser.</string>
    <string name="error_dialog_tip_offline_connection_timeout">Der opstod timeout for forbindelsen. Kontrollér, om du har forbindelse til internettet. Det kan også ske, når din server har travlt.</string>
    <string name="error_dialog_tip_sync_only_on_wifi">Hvis du har aktiveret indstillingen \"Synkroniser kun på Wi-Fi\", kan du kun synkronisere, når du har forbindelse til Wi-Fi.</string>
    <string name="error_dialog_tip_files_force_stop">Der ser ud til at være noget galt med din Nextcloud-app. Prøv at tvinge både Nextcloud-appen og Nextcloud Tabeller-appen til at stoppe.</string>
    <string name="error_dialog_tip_files_delete_storage">Hvis det ikke hjælper at tvinge dem til at stoppe, kan du prøve at rydde lageret for begge apps.</string>
    <string name="error_dialog_timeout_instance">Din server svarede ikke inden for den angivne tid. Sørg for, at din instans kører, som den skal.</string>
    <string name="error_dialog_timeout_toggle">Tjek din netværksforbindelse. Nogle gange hjælper det at slå mobildata eller Wi-Fi fra og til igen.</string>
    <string name="error_dialog_check_server">Svaret fra din server var ikke korrekt. Kontrollér, om du kan få adgang til Tabeller-appen via webbrugerfladen.</string>
    <string name="error_dialog_check_server_logs">Der er et problem med din opsætning af Nextcloud. Kig i serverens logfiler.</string>
    <string name="error_dialog_check_maintenance">Kontrollér, at din Nextcloud-instans ikke er i vedligeholdelsestilstand lige nu.</string>
    <string name="error_dialog_insufficient_storage">Din Nextcloud-instans har ikke mere ledig lagerplads. Slet nogle filer for at synkronisere dine lokale ændringer til skyen.</string>
    <string name="error_dialog_we_need_info">Vi har brug for følgende tekniske oplysninger for at hjælpe dig:</string>
    <string name="error_dialog_redirect">Din server svarede med HTTP-statuskoden 302, hvilket betyder, at appen Tabeller ikke er installeret på din server, eller at noget er forkert konfigureret. Det kan skyldes brugerdefinerede tilsidesættelser i en .htaccess-fil eller Nextcloud-apps som OID Client.</string>
    <string name="error_dialog_forbidden">Du har ikke tilstrækkelige rettigheder. Kontrollér tabeller, der er delt med dig og for nylig er blevet ændret.</string>
    <string name="error_dialog_version_not_parsable">Vi kunne ikke fastslå versionen af Tabeller-appen på serveren. Sørg for, at den er installeret og aktiveret.</string>
    <string name="error_dialog_account_might_not_be_authorized">Kontoen i din Nextcloud-app er måske ikke længere autoriseret.</string>
    <string name="error_dialog_user_not_found_in_database">Den aktuelle bruger svarer ikke til brugeren i vores database. Hvis du bruger LDAP på din Nextcloud-instans, har din Nextcloud-app måske gemt et gammelt bruger-ID.</string>
    <string name="error_dialog_capabilities_not_parsable">Vi kunne ikke hente din servers funktioner. Sørg for, at din server kører, som den skal, og at andre klientapps kan få adgang til Nextcloud.</string>
    <string name="error_dialog_attachment_upload_failed">En vedhæftet fil kunne ikke uploades. Prøv at dele den på en anden måde, og fortæl os om fejlen.</string>
    <string name="error_dialog_certificate">Der ser ud til at være noget galt med serverens certifikat. Kontrollér alle konti i Nextcloud-appen for at få flere oplysninger.</string>
    <string name="error_dialog_tip_disable_battery_optimizations">Deaktiver alle batterioptimeringer for Nextcloud og Tabeller-appen.</string>
    <string name="error_dialog_unknown_error">Din Nextcloud-instans ser ikke ud til at kunne nås. Kontrollér din internetforbindelse, og om du kan oprette forbindelse til din instans via en browser.</string>
    <string name="error_dialog_min_version">Tabeller-appen til Android kræver mindst version 3.18 af Nextcloud-appen til Android.</string>
